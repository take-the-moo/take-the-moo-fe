# 로컬 환경변수 템플릿. 복사해서 .env.local 로 만든다: cp .env.example .env.local
# 환경변수 파일은 .env.local 하나만 쓴다 (.env 사용 안 함).
# NEXT_PUBLIC_ 접두사 = 브라우저 번들에 그대로 노출된다. 공개돼도 되는 값만 붙인다.

# true면 BE 없이 src/mocks 데이터로 화면 개발
NEXT_PUBLIC_USE_MOCK=true

# Next dev 서버가 /api 요청을 넘길 백엔드 주소 (BE가 다른 기기면 http://<IP>:8080)
API_PROXY_TARGET=http://localhost:8080

# 네이버 지도 Client ID — NCP 콘솔 > Maps > Application > 인증 정보
# 주의: 계정 인증키(ncp_iam_…로 시작하는 Access Key ID)를 넣으면 401 인증 실패가 난다.
# 같은 Application의 Web 서비스 URL에 http://localhost:3000 등록 필요.
NEXT_PUBLIC_NAVER_MAP_KEY_ID=<Maps Client ID>

# SKT API 키 (서버 전용, 현재 미사용)
SKT_ACCESS_KEY_ID=<값>
